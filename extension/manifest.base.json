{
  "manifest_version": 3,
  "name": "PhiTeX Instant for Overleaf (unofficial)",
  "short_name": "PhiTeX Instant",
  "version": "0.5.0",
  "description": "Unofficial, experimental: an instant, incremental PhiTeX preview beside Overleaf's PDF. Not affiliated with Overleaf. Runs locally.",
  "minimum_chrome_version": "116",
  "permissions": [
    "offscreen",
    "storage",
    "unlimitedStorage",
    "alarms",
    "activeTab"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.overleaf.com/project/*"
      ],
      "js": [
        "dist/hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.overleaf.com/project/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/content-main.js",
        "dist/edits.js",
        "dist/zip.js",
        "dist/panel.js",
        "dist/session.js",
        "dist/engines.js",
        "dist/report.js",
        "dist/version.js",
        "dist/diagnostics.js",
        "dist/mirror.js",
        "dist/packages.js",
        "dist/news.js",
        "LICENSE.txt",
        "dist/tabrender.js",
        "dist/pdfjs/pdf.min.mjs",
        "dist/pdfjs/pdf.worker.min.mjs",
        "dist/vendor/viewer/*.js",
        "fonts/*",
        "shims/*"
      ],
      "matches": [
        "https://www.overleaf.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhiTeX Instant (unofficial): settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
