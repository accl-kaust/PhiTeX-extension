diff --git a/crates/phitex-ssa/Cargo.toml b/crates/phitex-ssa/Cargo.toml
index 37501c8..d7fa44c 100644
--- a/crates/phitex-ssa/Cargo.toml
+++ b/crates/phitex-ssa/Cargo.toml
@@ -9,8 +9,12 @@ phitex-syntax = { path = "../phitex-syntax" }
 rustc-hash = "2"
 tracing = "0.1.44"
 tracing-subscriber = { version = "0.3.23", default-features = false, features = ["fmt", "env-filter", "ansi"] }
+web-time = { version = "1", optional = true }
 
 [features]
+# `Instant` from the `web-time` crate (performance.now() in a browser), for
+# wasm32-unknown-unknown, where std's panics.
+web-time = ["dep:web-time"]
 # A tracing span per chunk built (with its paragraphs, values, imports and
 # time). Off by default: even disabled, 10^4 spans a megabyte cost ~3%.
 chunk-spans = []
