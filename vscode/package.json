{
  "name": "phitex-instant",
  "displayName": "PhiTeX ⚡ Instant",
  "description": "Instant LaTeX preview: pages update as you type, typeset by PhiTeX in VS Code itself.",
  "version": "0.5.2",
  "publisher": "accl-kaust",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/accl-kaust/PhiTeX-frontends"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "latex",
    "tex",
    "preview",
    "pdf"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:latex"
  ],
  "contributes": {
    "commands": [
      {
        "command": "phitex.preview",
        "title": "Open Preview",
        "category": "PhiTeX",
        "icon": "$(zap)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "phitex.preview",
          "when": "editorLangId == latex",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "phitex.preview",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorLangId == latex"
      }
    ],
    "configuration": {
      "title": "PhiTeX",
      "properties": {
        "phitex.engine": {
          "type": "string",
          "enum": [
            "builtin",
            "phitex watch"
          ],
          "default": "builtin",
          "markdownEnumDescriptions": [
            "The engine inside VS Code (WebAssembly): nothing to install, pages updated as you type.",
            "The `phitex` command's own `phitex watch`: the native engine, faster on large documents; pages updated when a file is saved (turn on auto-save)."
          ],
          "description": "Which engine typesets the preview."
        },
        "phitex.path": {
          "type": "string",
          "default": "phitex",
          "description": "The phitex command (for the \"phitex watch\" engine): a name on the PATH or a full path."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.85.0"
  }
}
